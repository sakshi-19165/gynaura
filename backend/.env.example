# MongoDB Atlas Connection URI (optional, falls back to local data.json if unset)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=gynaura

# Twilio SMS Credentials (optional, falls back to local demo mode with code display if unset)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM=+1234567890

# Google OAuth 2.0 Credentials (optional, enables "Continue with Google" sign-in)
GOOGLE_CLIENT_ID=
# Optional comma-separated allowlist of authorized doctor emails for Google sign-in
DOCTOR_EMAILS=

# Admin Portal Credentials
ADMIN_KEY=gyncare-admin-2026
ADMIN_EMAILS=

# Allowed CORS Origins (comma-separated, defaults to * if unset)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
